<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Dodger</title>
    <style>
        /* CSS Reset and Core Setup */
        * { box-sizing: border-box; user-select: none; }
        body { 
            margin: 0; 
            padding: 0; 
            overflow: hidden; 
            background-color: #0a0a1a; 
            color: #fff; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            touch-action: none; /* Prevents mobile scrolling */
        }

        canvas { display: block; }

        /* UI Overlays */
        #ui-layer {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            pointer-events: none;
            display: flex;
            flex-direction: column;
        }

        .screen {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(10, 10, 26, 0.9);
            pointer-events: auto;
            transition: opacity 0.3s ease;
            padding: 20px;
            text-align: center;
        }

        .hidden {
            opacity: 0;
            pointer-events: none !important;
        }

        /* Typography & Inputs */
        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            color: #0ff;
            text-shadow: 0 0 10px #0ff, 0 0 20px #0ff;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        h2 { color: #fff; font-size: 2rem; margin: 10px 0; }

        input {
            font-size: 1.5rem;
            padding: 15px;
            margin: 30px 0;
            border-radius: 10px;
            border: 2px solid #f0f;
            background: #111;
            color: #fff;
            text-align: center;
            outline: none;
            box-shadow: 0 0 15px rgba(255, 0, 255, 0.5);
            width: 80%;
            max-width: 300px;
            transition: box-shadow 0.2s;
        }

        input:focus { box-shadow: 0 0 25px rgba(255, 0, 255, 0.9); }

        button {
            font-size: 1.8rem;
            padding: 15px 40px;
            border-radius: 50px;
            border: none;
            background: linear-gradient(45deg, #0ff, #00b3b3);
            color: #000;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 0 20px #0ff;
            outline: none;
            text-transform: uppercase;
            animation: pulse 1.5s infinite;
            transition: transform 0.1s;
        }

        button:active { transform: scale(0.95); box-shadow: 0 0 10px #0ff; }

        @keyframes pulse {
            0% { box-shadow: 0 0 15px #0ff; }
            50% { box-shadow: 0 0 30px #0ff; }
            100% { box-shadow: 0 0 15px #0ff; }
        }

        /* Heads Up Display */
        #hud {
            display: flex;
            justify-content: space-between;
            padding: 15px 25px;
            font-size: 1.2rem;
            font-weight: bold;
            text-transform: uppercase;
            text-shadow: 0 0 5px #fff;
            pointer-events: none;
        }

        .hud-name { color: #0ff; text-shadow: 0 0 5px #0ff; }
        .hud-score { color: #f0f; text-shadow: 0 0 5px #f0f; }

    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>

    <div id="ui-layer">
        <!-- HUD (Visible during gameplay) -->
        <div id="hud" class="hidden">
            <div id="hudName" class="hud-name">Player</div>
            <div class="hud-score">Score: <span id="hudScore">0</span></div>
        </div>

        <!-- Title Screen -->
        <div id="titleScreen" class="screen">
            <h1>Neon Dodger</h1>
            <input type="text" id="playerNameInput" placeholder="Your First Name" maxlength="12" autocomplete="off">
            <button id="playBtn">Play</button>
        </div>

        <!-- Game Over Screen -->
        <div id="gameOverScreen" class="screen hidden">
            <h1 style="color: #f0f; text-shadow: 0 0 10px #f0f, 0 0 20px #f0f;">Game Over</h1>
            <h2>Score: <span id="finalScore">0</span></h2>
            <h2 style="color: #ff0;">Best: <span id="bestScore">0</span></h2>
            <br>
            <button id="restartBtn">Play Again</button>
        </div>
    </div>

    <script>
        // --- Setup & Context ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // UI Elements
        const titleScreen = document.getElementById('titleScreen');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const hud = document.getElementById('hud');
        const playerNameInput = document.getElementById('playerNameInput');
        const playBtn = document.getElementById('playBtn');
        const restartBtn = document.getElementById('restartBtn');
        const hudName = document.getElementById('hudName');
        const hudScore = document.getElementById('hudScore');
        const finalScoreEl = document.getElementById('finalScore');
        const bestScoreEl = document.getElementById('bestScore');

        // Game State Variables
        let w, h;
        let isPlaying = false;
        let animationId;
        let score = 0;
        let highScore = localStorage.getItem('neonDodgerBest') || 0;
        let frameCount = 0;
        let difficultyMultiplier = 1;

        // Entities
        let player = { x: 0, y: 0, radius: 18, color: '#0ff' };
        let targetX = 0;
        let obstacles = [];
        let particles = [];
        let stars = [];

        // Key states
        let keys = { ArrowLeft: false, ArrowRight: false };

        // --- Audio System (Web Audio API) ---
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioContext();

        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            
            const now = audioCtx.currentTime;
            
            if (type === 'start') {
                // Ascending chime
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.3);
                gain.gain.setValueAtTime(0.5, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now);
                osc.stop(now + 0.3);
            } else if (type === 'score') {
                // Short bright blip
                osc.type = 'square';
                osc.frequency.setValueAtTime(1200, now);
                gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                osc.start(now);
                osc.stop(now + 0.1);
            } else if (type === 'gameover') {
                // Descending crash
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(200, now);
                osc.frequency.exponentialRampToValueAtTime(50, now + 0.5);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.start(now);
                osc.stop(now + 0.5);
            }
        }

        // --- Initialization & Resizing ---
        function resize() {
            w = canvas.width = window.innerWidth;
            h = canvas.height = window.innerHeight;
            player.y = h - 80;
            if (!isPlaying) {
                player.x = w / 2;
                targetX = w / 2;
            }
            initStars();
        }
        window.addEventListener('resize', resize);

        function initStars() {
            stars = [];
            for (let i = 0; i < 50; i++) {
                stars.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    size: Math.random() * 2,
                    speed: Math.random() * 2 + 1
                });
            }
        }

        // Load saved name
        const savedName = localStorage.getItem('neonDodgerName');
        if (savedName) playerNameInput.value = savedName;

        // --- Controls ---
        // Mouse / Touch
        function handlePointerMove(e) {
            if (!isPlaying) return;
            e.preventDefault(); 
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            targetX = clientX;
        }
        
        canvas.addEventListener('mousemove', handlePointerMove);
        canvas.addEventListener('touchmove', handlePointerMove, { passive: false });
        canvas.addEventListener('touchstart', handlePointerMove, { passive: false });

        // Keyboard
        window.addEventListener('keydown', e => { if(keys.hasOwnProperty(e.code)) keys[e.code] = true; });
        window.addEventListener('keyup', e => { if(keys.hasOwnProperty(e.code)) keys[e.code] = false; });

        // --- Game Logic ---
        function startGame() {
            const name = playerNameInput.value.trim() || 'Guest';
            localStorage.setItem('neonDodgerName', name);
            hudName.textContent = name;
            
            // Audio setup requires user gesture to resume
            if (audioCtx.state === 'suspended') audioCtx.resume();
            playSound('start');

            score = 0;
            frameCount = 0;
            difficultyMultiplier = 1;
            obstacles = [];
            particles = [];
            hudScore.textContent = score;

            titleScreen.classList.add('hidden');
            gameOverScreen.classList.add('hidden');
            hud.classList.remove('hidden');

            player.x = w / 2;
            targetX = w / 2;
            isPlaying = true;

            cancelAnimationFrame(animationId);
            gameLoop();
        }

        function createParticles(x, y, color) {
            for(let i=0; i<15; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    life: 1,
                    color: color
                });
            }
        }

        function gameOver() {
            isPlaying = false;
            playSound('gameover');
            createParticles(player.x, player.y, player.color);
            
            // Draw one last frame with explosion
            ctx.clearRect(0, 0, w, h);
            drawBackground();
            drawObstacles();
            drawParticles();
            
            hud.classList.add('hidden');
            gameOverScreen.classList.remove('hidden');
            
            finalScoreEl.textContent = score;
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('neonDodgerBest', highScore);
            }
            bestScoreEl.textContent = highScore;
        }

        function update() {
            // Update Keyboard target
            const keyboardSpeed = 8;
            if (keys.ArrowLeft) targetX -= keyboardSpeed;
            if (keys.ArrowRight) targetX += keyboardSpeed;

            // Smooth follow for player
            player.x += (targetX - player.x) * 0.25;

            // Constrain to screen
            if (player.x < player.radius) { player.x = player.radius; targetX = player.radius; }
            if (player.x > w - player.radius) { player.x = w - player.radius; targetX = w - player.radius; }

            // Difficulty progression
            difficultyMultiplier = 1 + (score * 0.05);

            // Spawn Obstacles
            frameCount++;
            let spawnRate = Math.max(15, Math.floor(50 - (score * 1.5))); // Caps at fastest rate of 15 frames
            
            if (frameCount % spawnRate === 0) {
                const size = Math.random() * 30 + 20;
                const isMagenta = Math.random() > 0.5;
                obstacles.push({
                    x: Math.random() * (w - size),
                    y: -size,
                    w: size,
                    h: size,
                    speed: (Math.random() * 3 + 4) * difficultyMultiplier,
                    color: isMagenta ? '#f0f' : '#ff0'
                });
            }

            // Update Obstacles & Check Collision
            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.y += obs.speed;

                // Collision detection (Circle vs AABB Rectangle)
                let testX = player.x;
                let testY = player.y;

                if (player.x < obs.x) testX = obs.x;      
                else if (player.x > obs.x + obs.w) testX = obs.x + obs.w;   
                if (player.y < obs.y) testY = obs.y;      
                else if (player.y > obs.y + obs.h) testY = obs.y + obs.h;   

                let distX = player.x - testX;
                let distY = player.y - testY;
                let distance = Math.sqrt((distX*distX) + (distY*distY));

                if (distance <= player.radius - 2) { // -2 for slight forgiveness
                    gameOver();
                    return; // Stop updating if dead
                }

                // Check out of bounds / score increase
                if (obs.y > h) {
                    obstacles.splice(i, 1);
                    score++;
                    hudScore.textContent = score;
                    if (score % 5 === 0) playSound('score');
                }
            }

            // Update Background Stars
            stars.forEach(star => {
                star.y += star.speed * (difficultyMultiplier * 0.5);
                if (star.y > h) {
                    star.y = 0;
                    star.x = Math.random() * w;
                }
            });

            // Update Particles
            for(let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 0.05;
                if(p.life <= 0) particles.splice(i, 1);
            }
        }

        // --- Rendering ---
        function drawBackground() {
            // Draw Stars
            ctx.fillStyle = '#fff';
            stars.forEach(star => {
                ctx.globalAlpha = Math.random() * 0.5 + 0.3;
                ctx.beginPath();
                ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                ctx.fill();
            });
            ctx.globalAlpha = 1.0;
        }

        function drawObstacles() {
            obstacles.forEach(obs => {
                ctx.shadowBlur = 15;
                ctx.shadowColor = obs.color;
                ctx.fillStyle = obs.color;
                ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
            });
            ctx.shadowBlur = 0; // Reset shadow
        }

        function drawPlayer() {
            ctx.shadowBlur = 20;
            ctx.shadowColor = player.color;
            ctx.fillStyle = player.color;
            ctx.beginPath();
            ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
            ctx.fill();
            
            // Inner core
            ctx.fillStyle = '#fff';
            ctx.beginPath();
            ctx.arc(player.x, player.y, player.radius * 0.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
        }

        function drawParticles() {
            particles.forEach(p => {
                ctx.globalAlpha = p.life;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, 4, 0, Math.PI*2);
                ctx.fill();
            });
            ctx.globalAlpha = 1.0;
        }

        function gameLoop() {
            if (!isPlaying) return;
            
            update();
            
            ctx.clearRect(0, 0, w, h);
            drawBackground();
            drawObstacles();
            drawParticles();
            drawPlayer();

            animationId = requestAnimationFrame(gameLoop);
        }

        // Event Listeners for UI
        playBtn.addEventListener('click', startGame);
        restartBtn.addEventListener('click', startGame);

        // Initial setup
        resize();
    </script>
</body>
</html>
